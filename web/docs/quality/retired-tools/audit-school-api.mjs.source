import fs from 'node:fs/promises';
const origin = 'http://94.184.32.84:8090';
const report = { checkedAt: new Date().toISOString(), roles: {} };
for (const [role, phone] of [
  ['Manager', '+989120000104'],
  ['Teacher', '+989120000102'],
  ['Student', '+989120000101'],
  ['Parent', '+989120000103'],
]) {
  let token;
  const call = async (path, method = 'GET', body) => {
    const response = await fetch(origin + path, {
      method,
      headers: {
        ...(token ? { Authorization: 'Bearer ' + token } : {}),
        ...(body ? { 'Content-Type': 'application/json' } : {}),
      },
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(20000),
    });
    const data = await response.json().catch(() => null);
    return { status: response.status, data };
  };
  try {
    const challenge = await call('/api/v1/auth/otp/challenges', 'POST', { phoneNumber: phone });
    const login = await call('/api/v1/auth/otp/verify', 'POST', {
      phoneNumber: phone,
      challengeId: challenge.data?.challengeId,
      code: '123456',
      deviceName: 'Makan school read-only contract audit',
    });
    if (login.status !== 200) {
      report.roles[role] = { loginStatus: login.status, code: login.data?.code };
      continue;
    }
    token = login.data.accessToken;
    const spaces = await call('/api/v1/workspaces/me');
    const active = spaces.data?.find(
      (space) => space.workspaceType === 'Organization' && space.role === role,
    );
    const results = {
      spaces,
      selection: active
        ? await call('/api/v1/workspaces/select', 'POST', {
            workspaceType: 'Organization',
            membershipId: active.membershipId,
            role,
          })
        : null,
    };
    const paths = [
      '/api/v1/academic/classes',
      '/api/v1/organization/people?page=1&pageSize=30',
      '/api/v1/reports/manager/enrollments?PageNumber=1&PageSize=30',
      '/api/v1/reports/manager/teacher-workload?PageNumber=1&PageSize=30',
      '/api/v1/organization/guardian-relations?page=1&pageSize=30',
      '/api/v1/academic/assignments',
      '/api/v1/academic/exams',
      '/api/v1/dashboards/' + role.toLowerCase(),
      '/api/v1/guardian/children',
    ];
    const read = await Promise.all(paths.map(async (path) => [path, await call(path)]));
    Object.assign(results, Object.fromEntries(read));
    report.roles[role] = results;
    console.log(
      role +
        ' ' +
        JSON.stringify(
          Object.fromEntries(
            read.map(([path, result]) => [
              path,
              {
                status: result.status,
                code: result.data?.code,
                count: Array.isArray(result.data) ? result.data.length : result.data?.totalCount,
              },
            ]),
          ),
        ),
    );
  } finally {
    if (token) await call('/api/v1/auth/logout', 'POST').catch(() => {});
  }
}
await fs.mkdir('tmp', { recursive: true });
await fs.writeFile('tmp/school-role-data.json', JSON.stringify(report, null, 2));
