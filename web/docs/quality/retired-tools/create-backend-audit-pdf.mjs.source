import fs from 'node:fs/promises';
import path from 'node:path';
import { chromium } from '@playwright/test';

const out = path.resolve('output/pdf/makan-backend-issues-and-test-plan-fa.pdf');
const temp = path.resolve('tmp/pdfs/backend-audit-20261029');
const audit = JSON.parse(
  await fs.readFile('docs/backend-report-readonly-audit-20261029.json', 'utf8'),
);
const old = JSON.parse(await fs.readFile('docs/messaging-direct-live-qa.json', 'utf8'));
const received = JSON.parse(await fs.readFile('docs/recipient-inbox-live-qa.json', 'utf8'));
const arabic = await fs.readFile(
  'node_modules/@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2',
);
const latin = await fs.readFile(
  'node_modules/@fontsource-variable/vazirmatn/files/vazirmatn-latin-wght-normal.woff2',
);
const logo = await fs.readFile('public/icons/makan-192.png');
const esc = (value) =>
  String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
const code = (value) => `<code dir="ltr">${esc(value)}</code>`;
const para = (value) => `<p>${value}</p>`;
const list = (items) => `<ol>${items.map((x) => `<li>${x}</li>`).join('')}</ol>`;
const ul = (items) => `<ul>${items.map((x) => `<li>${x}</li>`).join('')}</ul>`;
const table = (headers, rows, cls = '') =>
  `<table class="${cls}"><thead><tr>${headers.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.map((row) => `<tr>${row.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
const find = (role, tail) => audit.requests.find((r) => r.role === role && r.path.endsWith(tail));
const stamp = new Intl.DateTimeFormat('fa-IR', {
  timeZone: 'Asia/Tehran',
  dateStyle: 'long',
  timeStyle: 'short',
}).format(new Date(audit.checkedAt));
const chat = '68f10dcc-d3f6-4c67-95b2-adb87576ab9e';
const cls = 'a673db51-f459-4777-833c-fd35ad40ce68';
const lesson = '73bdf5ca-cb13-4840-8804-69b8fc5d20fd';
const pages = [];
const page = (section, title, body) => pages.push({ section, title, body });
const part = (heading, text) => `<h2>${heading}</h2>${text}`;
function issue({
  id,
  title,
  state,
  priority,
  impact,
  observed,
  steps,
  expected,
  fix,
  acceptance,
  evidence,
}) {
  page(
    'یافته‌های قابل پیگیری',
    `${id}  ${title}`,
    para(`<strong>وضعیت:</strong> ${state}　 <strong>اولویت پیشنهادی:</strong> ${priority}`) +
      para(`<strong>اثر:</strong> ${impact}`) +
      part('نتیجهٔ مشاهده‌شده', para(observed)) +
      part('روش بازتولید', list(steps)) +
      part('نتیجهٔ مورد انتظار', para(expected)) +
      part('اقدام پیشنهادی تیم بک‌اند', para(fix)) +
      part('شرط بستن مورد', para(acceptance)) +
      `<div class="evidence"><strong>شاهد و ردیابی</strong>${evidence}</div>`,
  );
}

page(
  'خلاصهٔ مدیریتی',
  'گزارش مشکلات بک‌اند و راهنمای آزمون ماکان',
  para(
    'این سند برای مالک محصول، مسئول QA و توسعه‌دهندهٔ بک‌اند تهیه شده است. هدف، تبدیل مشکلات گزارش‌شده به موارد قابل بازتولید و آزمون پذیرش است؛ پاسخ خطا به‌تنهایی دلیل وجود باگ امنیتی یا خرابی منطق سرور نیست.',
  ) +
    para(
      `<strong>محیط بررسی:</strong> ${code(audit.server)}<br><strong>آخرین بررسی مستقیم:</strong> ${stamp}<br><strong>دامنه:</strong> فرد عادی، دانشجو، استاد، والدین و مدیر آموزشگاه؛ پنل مستقل مالک پلتفرم خارج از این گزارش است.`,
