for (const [prefix, title, tests] of suites) {
  page(
    'فهرست آزمون پذیرش',
    title,
    para(
      'این جدول دستور اجرای آزمون است و به معنی پاس‌شدن همهٔ ردیف‌ها نیست. برای هر ردیف، نتیجه را «موفق / ناموفق / متوقف / اجرا نشده» همراه با حساب، زمینه، زمان و trace ثبت کنید. آزمون‌های نوشتنی فقط روی seed قابل بازیابی انجام شوند.',
    ) +
      table(
        ['شناسه', 'روش اجرا', 'نتیجهٔ مورد انتظار'],
        tests.map(([step, result], i) => [
          code(prefix + String(i + 1).padStart(2, '0')),
          step,
          result,
        ]),
        'tests',
      ) +
      para(
        '<strong>ثبت نتیجه:</strong> نسخهٔ انتشار، حساب و نقش فعال، دادهٔ اولیه، HTTP status/code، traceId، تصویر بدون اطلاعات ورود و وضعیت داده پس از آزمون را بنویسید. مشاهدهٔ۲۰۰ به‌تنهایی صحت مجوز، داده یا امنیت را ثابت نمی‌کند.',
      ),
  );
}

