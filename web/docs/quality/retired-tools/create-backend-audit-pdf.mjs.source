        [
          'آموزشگاه',
          'اعضا، کاتالوگ، جزوه و دعوت والد پیاده و بررسی شده‌اند؛ اختلاف دسترسی roster دانشجو نیازمند تعیین تکلیف است.',
        ],
        [
          'کامل‌بودن دامنه',
          'درخواست‌های AI، منابع و خرید شخصی و همچنین بسیاری از آزمون‌های منفی هنوز کامل تأیید نشده‌اند.',
        ],
      ],
    ) +
    part(
      'نحوهٔ خواندن سند',
      para(
        'هفت یافتهٔ BE شامل موانع عملیاتی، اختلاف قرارداد و موارد نیازمند تصمیم‌اند؛ همهٔ آن‌ها «باگ قطعی کد بک‌اند» نامیده نمی‌شوند. سپس شکاف‌های قرارداد، موارد فرانت‌اند و ۸۰ سناریوی آزمون جدا آمده‌اند. موارد P1 پیش از انتشار قابلیت مرتبط تعیین تکلیف شوند؛ P0 تأییدشده در شواهد موجود نداریم.',
      ),
    ) +
    para(
      '<strong>محدودیت:</strong> این گزارش ممیزی همهٔ کد، دیتابیس، ۲۹۱ مسیر و امنیت سرور نیست. لاگ داخلی، تنظیمات policy، صف Safety و محیط پرداخت در اختیار این بررسی نبوده‌اند.',
    ),
);

page(
  'آماده‌سازی آزمون',
  'محیط و دادهٔ تست معتبر',
  para(
    'آزمون تازه، مستقیم به HTTP بک‌اند و با نشست‌های seed تازه انجام شد؛ محدودیت allowlist کلاینت در این نتایج دخالت ندارد. فقط ورود، انتخاب زمینهٔ همین نشست و دریافت اطلاعات انجام شد؛ پیام، فایل، عضویت یا تنظیم حریم خصوصی جدیدی تغییر نکرد.',
