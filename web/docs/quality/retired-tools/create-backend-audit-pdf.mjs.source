    ) +
    para(
      '<strong>حریم اطلاعات:</strong> توکن، cookie، کد ورود و بدنهٔ پیام‌ها در این PDF قرار نگرفته‌اند. لاگ خصوصی سرور و علت ریشه‌ای exceptionها در اختیار تهیه‌کننده نبوده است.',
    ),
);

// Keep repeated instructions out of the end of every test table.
for (const p of pages) {
  if (p.section === 'فهرست آزمون پذیرش')
    p.body = p.body.slice(0, p.body.lastIndexOf('<p><strong>ثبت نتیجه:'));
  if (p.title === 'محیط و دادهٔ تست معتبر')
    p.body = p.body.slice(0, p.body.lastIndexOf('<p>در اجرای تازه'));
  if (p.title === 'ترتیب رفع و معیار پذیرش نهایی')
    p.body = p.body.slice(0, p.body.lastIndexOf('<p>پذیرش نهایی فقط'));
}
const sources = pages.at(-1);
const split = sources.body.indexOf('<h2>شناسه‌های کلیدی</h2>');
const traces = sources.body.slice(split);
sources.body = sources.body.slice(0, split);
page(
  'پیوست ردیابی',
  'شناسه‌های پیگیری و ثبت نتیجه',
  traces +
    part(
      'پیگیری درخواست‌های تازه',
      table(
        ['مورد', 'traceId'],
        [
          ['Direct دانشجو', code(find('Student', '/' + chat)?.traceId)],
          ['Direct استاد', code(find('Teacher', '/' + chat)?.traceId)],
          [
            'roster معلمان برای Student',
            code(find('Student', '/teachers?Page=1&PageSize=30')?.traceId),
          ],
          [
            'summary فردی Student',
            code(
              audit.requests.find(
                (r) => r.role === 'Student' && r.path === '/api/v1/commerce/summary',
              )?.traceId,
            ),
          ],
          ['Parent و جزوه ممنوع', code(find('Parent', '/' + lesson)?.traceId)],
        ],
      ),
    ) +
    para(
      'trace درخواست تازه را همراه زمان دقیق تهران و نسخهٔ استقرار به تیم بک‌اند بدهید. traceهای قدیمی فقط همان اجرای ثبت‌شده را نمایندگی می‌کنند؛ وضعیت رفع باید با درخواست تازه تأیید شود.',
    ),
);

const css = `
@font-face{font-family:Makan;src:url(data:font/woff2;base64,${arabic.toString('base64')}) format('woff2');font-weight:100 900;unicode-range:U+0600-06FF,U+0750-077F,U+08A0-08FF,U+200C-200F,U+FB50-FDFF,U+FE70-FEFC}
@font-face{font-family:Makan;src:url(data:font/woff2;base64,${latin.toString('base64')}) format('woff2');font-weight:100 900;unicode-range:U+0000-00FF,U+2000-200B,U+2010-206F}
@page{size:A4;margin:0}*{box-sizing:border-box}html,body{margin:0;padding:0;font-family:Makan,Tahoma,sans-serif;color:#141414;background:#fff;font-size:14.2px;line-height:1.85;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.page{width:210mm;height:297mm;padding:14mm 17mm 13mm;display:flex;flex-direction:column;break-after:page}.page:last-child{break-after:auto}.top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ddd;padding-bottom:10px;margin-bottom:18px;flex-shrink:0}.brand{display:flex;align-items:center;gap:8px;font-weight:800;font-size:20px}.brand img{width:32px;height:32px;object-fit:contain}.top small{font-size:10.5px;color:#555}.content{flex:1;min-height:0}.section{font-size:11.5px;color:#555;margin-bottom:4px}h1{font-size:25px;line-height:1.6;font-weight:800;margin:0 0 16px;color:#000}h2{font-size:16px;font-weight:750;line-height:1.7;margin:17px 0 5px;color:#000}p{margin:7px 0;text-align:right}strong{font-weight:750}ul,ol{margin:6px 0;padding-right:23px;padding-left:0}li{padding-right:2px;margin:6px 0}code{font-family:Consolas,'Courier New',monospace;font-size:11.5px;direction:ltr;unicode-bidi:isolate;display:inline-block;max-width:100%;overflow-wrap:anywhere;text-align:left;color:#333;line-height:1.6}table{border-collapse:collapse;width:100%;margin:14px 0;font-size:13.4px;line-height:1.8}th,td{border:1px solid #d9d9d9;padding:9px 10px;vertical-align:middle;text-align:right}th{background:#eaf1f8;color:#111;font-weight:750}tbody tr:nth-child(even){background:#fafbfc}td:first-child{width:23%;font-weight:650}.tests td:first-child{width:8%;text-align:center}.tests td:nth-child(2){width:47%}.tests td:nth-child(3){width:45%}.tests{font-size:13px;line-height:1.75}.tests td{padding:9px}.issue h2{margin-top:13px}.issue p{margin:6px 0}.issue li{margin:5px 0}.evidence{border-top:1px solid #ddd;padding-top:12px;margin-top:15px;font-size:12px;color:#444}.evidence>strong{display:block}.evidence p{margin:5px 0}.evidence code{display:block;margin-top:4px}footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #ddd;margin-top:18px;padding-top:9px;font-size:10.5px;color:#555;flex-shrink:0}bdi{unicode-bidi:isolate;direction:ltr}
`;
const fa = (n) => new Intl.NumberFormat('fa-IR').format(n);
const html = `<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>گزارش مشکلات بک‌اند ماکان و راهنمای آزمون</title><style>${css}</style></head><body>${pages.map((p, i) => `<section class="page ${p.section === 'یافته‌های قابل پیگیری' ? 'issue' : ''}"><header class="top"><div class="brand"><img alt="" src="data:image/png;base64,${logo.toString('base64')}">ماکان</div><small>گزارش شواهد و آزمون پذیرش بک‌اند</small></header><main class="content"><div class="section">${p.section}</div><h1>${p.title}</h1>${p.body}</main><footer><span>محیط تست 8090 | ۲۹ اکتبر ۲۰۲۶</span><span>صفحهٔ ${fa(i + 1)} از ${fa(pages.length)}</span></footer></section>`).join('')}</body></html>`;
await fs.mkdir(path.dirname(out), { recursive: true });
await fs.mkdir(temp, { recursive: true });
await fs.writeFile(path.join(temp, 'source.html'), html);
const browser = await chromium.launch({ channel: 'chrome', headless: true });
try {
  const page = await browser.newPage({ viewport: { width: 794, height: 1123 } });
  await page.setContent(html, { waitUntil: 'load' });
  await page.evaluate(() => document.fonts.ready);
  const layout = await page.locator('.page').evaluateAll((items) =>
    items.map((p, i) => {
      const content = p.querySelector('.content'),
        footer = p.querySelector('footer');
      return {
        page: i + 1,
        title: p.querySelector('h1').textContent,
        height: content.clientHeight,
        scroll: content.scrollHeight,
        lastBottom: content.lastElementChild.getBoundingClientRect().bottom,
        footerTop: footer.getBoundingClientRect().top,
        width: p.clientWidth,
        scrollWidth: p.scrollWidth,
      };
    }),
  );
  await fs.writeFile(path.join(temp, 'layout.json'), JSON.stringify(layout, null, 2));
  const failures = layout.filter(
    (p) => p.scroll > p.height + 1 || p.lastBottom > p.footerTop - 5 || p.scrollWidth > p.width + 1,
  );
  if (failures.length) throw Error('PDF page overflow: ' + JSON.stringify(failures));
  await page.pdf({
    path: out,
    format: 'A4',
    preferCSSPageSize: true,
    printBackground: true,
    tagged: true,
  });
  await fs.writeFile(
    path.join(temp, 'verification.json'),
    JSON.stringify(
      {
        output: out,
        pages: pages.length,
        testCases: suites.reduce((s, x) => s + x[2].length, 0),
        checkedAt: audit.checkedAt,
        layout: 'PASS',
      },
      null,
      2,
    ),
  );
  console.log(JSON.stringify({ output: out, pages: pages.length, tests: 80, layout: 'PASS' }));
} finally {
  await browser.close();
}
