import fs from 'node:fs';
import postcss from 'postcss';
const file='src/features/personal/messaging/messenger.module.css';
const source=postcss.parse(fs.readFileSync(file,'utf8'));
const replaced=new Set(['.messenger','.messenger:has(.room)','.sidebar','.sidebarHead','.sidebarHead h1','.inboxContext','.search','.search input','.filter','.filter select','.list','.chatItem','.avatar','.chatSummary strong','.chatSummary time','.preview','.unread','.selected','.sidebarFoot','.floating','.room','.roomHeader','.roomHeader .avatar','.identity h2','.identity p','.history','.bubble','.own','.messageMeta','.messageMeta > button','.composerArea','.composer','.composer textarea','.send','.emptyRoom','.emptyRoom > span','.emptyRoom h2','.emptyRoom p']);
let removed=0;
source.walkRules(rule=>{if(replaced.has(rule.selector)){rule.remove();removed++;}});
source.walkAtRules(rule=>{if(rule.nodes?.length===0)rule.remove();});
fs.writeFileSync(file,source.toString()+`
/* V2 reference geometry. Replaces earlier duplicate rules, including their media overrides. */
.messenger {display:grid;grid-template-columns:320px minmax(0,1fr);height:100%;min-height:0;width:100%;overflow:hidden;background:var(--surface);}
.messenger:has(.room) {grid-template-columns:320px minmax(0,1fr);}
.sidebar {position:relative;display:flex;flex-direction:column;min-height:0;min-width:0;border-inline-end:1px solid var(--border);background:var(--surface);}
.sidebarHead {display:none;}
.search {display:flex;align-items:center;gap:10px;background:var(--soft);border:0;border-radius:10px;margin:20px 18px 12px;padding:0 14px;color:var(--muted);height:48px;flex-shrink:0;}
.search input {border:0;box-shadow:none;background:transparent;padding:0;min-height:44px;font-size:13px;}
.searchSubmit {position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden;}
.filter {display:flex;gap:4px;border:0;background:var(--soft);border-radius:10px;margin:0 18px 12px;padding:5px;min-height:48px;flex-shrink:0;}
.filter button {flex:1;border:0;border-radius:8px;background:transparent;color:var(--muted);font-size:12px;min-height:38px;}
.filter button[aria-pressed='true'] {color:var(--primary);background:var(--surface);box-shadow:0 2px 6px #27335a05;}
.list {flex:1;min-height:0;overflow-y:auto;padding:0 12px 18px;}
.chatItem {display:flex;align-items:center;gap:12px;width:100%;padding:16px 10px;border-radius:12px;min-height:86px;}
.selected {background:var(--primary-soft)!important;}
.avatar {width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:50%;border:1px solid #e3e6fc;background:var(--primary-soft);color:var(--primary);font-size:17px;font-weight:650;overflow:hidden;}
.chatSummary strong {font-size:13px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.chatSummary time {font-size:10px;color:var(--muted);white-space:nowrap;}
.preview {display:block;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted);font-size:11px;}
.unread {display:flex;align-items:center;justify-content:center;width:7px;height:7px;min-width:7px;border-radius:50%;background:var(--primary);color:transparent;font-size:0;padding:0;}
.sidebarFoot {position:absolute;clip-path:inset(50%);width:1px;height:1px;overflow:hidden;}
.floating {position:fixed;top:14px;left:76px;width:48px;height:48px;display:grid;place-items:center;border:0;border-radius:12px;background:transparent;color:var(--text);box-shadow:none;z-index:21;}
.floating:hover {background:var(--soft);}
.room {display:flex;flex-direction:column;min-width:0;min-height:0;background:var(--bg);background-image:radial-gradient(#cbd1e229 .6px,transparent .6px);background-size:20px 20px;}
.roomHeader {display:flex;align-items:center;gap:10px;height:76px;min-height:76px;padding:10px 20px;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;}
.roomHeader .avatar {width:40px;height:40px;font-size:16px;}
.identity h2 {font-size:14px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.identity p {font-size:10px;color:var(--muted);margin-top:2px;}
.room[data-scope='Personal'] .scope {display:none;}
.history {display:flex;flex-direction:column;gap:20px;flex:1;min-height:0;overflow-y:auto;padding:28px 24px;scroll-behavior:auto;}
.bubble {position:relative;background:var(--surface);border:1px solid #e8eaf3;border-radius:18px 18px 5px 18px;padding:12px 16px 6px;max-width:min(84%,620px);min-width:0;box-shadow:0 3px 10px #23345404;font-size:14px;align-self:flex-end;overflow-wrap:anywhere;}
.own {background:var(--primary-soft);border-color:#e3e5ff;border-radius:18px 18px 18px 5px;align-self:flex-start;}
.messageMeta {display:flex;align-items:center;justify-content:flex-end;gap:4px;font-size:10px;color:var(--muted);direction:ltr;min-height:16px;margin-top:4px;}
.messageMeta > button {position:absolute;inset-inline-end:0;top:0;display:grid;place-items:center;width:44px;height:44px;min-height:44px;border:0;background:var(--surface);border-radius:12px;color:var(--primary);opacity:0;pointer-events:none;}
.bubble:hover .messageMeta > button,.bubble:focus-within .messageMeta > button {opacity:1;pointer-events:auto;}
.composerArea {padding:14px 18px max(14px,env(safe-area-inset-bottom));border-top:1px solid var(--border);background:var(--surface);flex-shrink:0;}
.composer {display:flex;align-items:center;gap:8px;background:transparent;border:0;border-radius:0;padding:0;box-shadow:none;}
.composeInput {border:1px solid #e2e5ef;border-radius:999px;display:flex;align-items:center;padding:0 14px;flex:1;min-width:0;}
.composer textarea {width:100%;min-height:48px;height:48px;max-height:120px;border:0;box-shadow:none;background:transparent;resize:none;font-size:14px;line-height:24px;padding:12px 0;border-radius:0;}
.send {display:grid;place-items:center;width:44px;height:44px;flex-shrink:0;border:0;background:transparent;color:var(--primary);border-radius:50%;}
.emptyRoom {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:32px;text-align:center;background:var(--bg);min-width:0;}
.emptyRoom > span {display:grid;place-items:center;width:56px;height:56px;border-radius:18px;background:var(--primary-soft);color:var(--primary);}
.emptyRoom h2 {font-size:17px;}.emptyRoom p {font-size:13px;color:var(--muted);max-width:360px;}
@media(min-width:768px) and (max-width:1199px) {.messenger,.messenger:has(.room) {grid-template-columns:300px minmax(0,1fr);}.history {padding:24px 20px;}.bubble {max-width:92%;}}
@media(max-width:767px) {
 .messenger {display:block;background:var(--bg);}.sidebar {height:100%;width:100%;border:0;background:var(--bg);}
 .sidebarHead {display:block;padding:20px 20px 4px;}.inboxContext {font-size:13px;line-height:1.9;color:var(--muted);}
 .search {margin:14px 20px 16px;}.filter {margin:0 20px 16px;}.list {padding:0 10px 18px;}
 .chatItem {min-height:86px;padding:16px 10px;}.floating {top:7px;left:56px;width:44px;height:44px;}
 .room,.emptyRoom {display:none;height:100%;width:100%;}.activeChat .sidebar {display:none;}.activeChat .room {display:flex;}
 .roomHeader {height:76px;min-height:76px;padding:10px 12px;}.roomHeader .avatar {width:38px;height:38px;}
 .history {padding:22px 16px;gap:16px;}.bubble {max-width:84%;font-size:14px;padding:10px 14px 6px;}
 .composerArea {padding:12px 12px max(12px,env(safe-area-inset-bottom));}
}
`);
fs.writeFileSync('docs/quality/VISUAL_RULE_REPLACEMENTS.json',JSON.stringify({file,removedDuplicateRules:removed,selectors:[...replaced],source:'Supplied V2 prototype and PDF, pages 2 and 3'},null,2));
const global=postcss.parse(fs.readFileSync('src/app/globals.css','utf8'));
global.walkRules(rule=>{if(rule.selector==='.button-primary:hover')rule.walkDecls('background',d=>d.value='var(--primary-hover)');});
fs.writeFileSync('src/app/globals.css',global.toString());
