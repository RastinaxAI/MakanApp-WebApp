{
  "name": "makan-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:design-review": "node scripts/design-review.mjs",
    "preview:upgrade": "node scripts/design-review.mjs --production",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/generate-contract.mjs",
    "api:update": "node scripts/fetch-contract.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:personal": "playwright test",
    "lint": "node scripts/check-source.mjs",
    "design:build": "node scripts/build-design.mjs",
    "generated:check": "node scripts/check-generated.mjs",
    "quality": "node scripts/quality.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check src tests/browser tests/unit tests/fixtures scripts design/tokens.json *.ts *.mts *.mjs package.json",
    "repro:check": "node scripts/repro-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.2.8",
    "@hookform/resolvers": "5.2.2",
    "@majidh1/jalalidatepicker": "1.0.0",
    "@microsoft/signalr": "9.0.19",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-direction": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.3",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
